{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://merrinworld.uk/schemas/pae/case-v0.1.json",
  "title": "PAE case v0.1",
  "type": "object",
  "required": [
    "case_id",
    "title",
    "status",
    "hypotheses",
    "requirements",
    "sources",
    "evidence_items",
    "research_options"
  ],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "status": {"enum": ["method_fixture", "research", "paused", "closed"]},
    "hypotheses": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/hypothesis"}},
    "requirements": {"type": "array", "items": {"$ref": "#/$defs/requirement"}},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "evidence_items": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "research_options": {"type": "array", "items": {"$ref": "#/$defs/researchOption"}}
  },
  "$defs": {
    "hypothesis": {
      "type": "object",
      "required": ["id", "label", "description"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "requirement": {
      "type": "object",
      "required": ["id", "question", "criticality", "hypothesis_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "question": {"type": "string", "minLength": 1},
        "criticality": {"type": "integer", "minimum": 1, "maximum": 5},
        "hypothesis_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "target_independent_streams": {"type": "integer", "minimum": 1},
        "primary_required": {"type": "boolean"},
        "contrary_required": {"type": "boolean"}
      }
    },
    "source": {
      "type": "object",
      "required": ["id", "title", "source_class", "independence_group", "derived_from"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "source_class": {"enum": ["primary", "investigative", "contextual", "claim", "fixture"]},
        "independence_group": {"type": "string", "minLength": 1},
        "derived_from": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "string"}
      }
    },
    "evidence": {
      "type": "object",
      "required": ["id", "requirement_id", "source_ids", "direction", "verification"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "requirement_id": {"type": "string", "minLength": 1},
        "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "direction": {"enum": ["supports", "contradicts", "mixed", "context"]},
        "verification": {"enum": ["unverified", "partly_verified", "verified", "disputed"]},
        "notes": {"type": "string"}
      }
    },
    "researchOption": {
      "type": "object",
      "required": [
        "id",
        "requirement_id",
        "description",
        "expected_discrimination",
        "reliability_potential",
        "accessibility",
        "urgency",
        "cost"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "requirement_id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "expected_discrimination": {"type": "integer", "minimum": 0, "maximum": 5},
        "reliability_potential": {"type": "integer", "minimum": 0, "maximum": 5},
        "accessibility": {"type": "integer", "minimum": 0, "maximum": 5},
        "urgency": {"type": "integer", "minimum": 0, "maximum": 5},
        "cost": {"type": "integer", "minimum": 0, "maximum": 5},
        "blocked": {"type": "boolean"}
      }
    }
  }
}
