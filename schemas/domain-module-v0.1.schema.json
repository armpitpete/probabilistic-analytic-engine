{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://merrinworld.uk/schemas/pae/domain-module-v0.1.json",
  "title": "PAE domain module v0.1",
  "type": "object",
  "required": ["interface_version", "domain_id", "version", "title", "scope", "applicable_claims", "required_hypothesis_classes", "evidence_categories", "indicators", "default_sufficiency_profile", "prohibited_inference_jumps"],
  "properties": {
    "interface_version": {"const": "0.1"},
    "domain_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "applicable_claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "required_hypothesis_classes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "evidence_categories": {"type": "array", "minItems": 1},
    "indicators": {"type": "array", "minItems": 1},
    "default_sufficiency_profile": {"type": "object"},
    "prohibited_inference_jumps": {"type": "array", "minItems": 1}
  }
}
