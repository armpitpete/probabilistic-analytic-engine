{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://merrinworld.uk/schemas/pae/historical-pilot-v0.1.json",
  "title": "PAE cutoff-controlled historical pilot v0.1",
  "type": "object",
  "required": [
    "pilot_id",
    "case_id",
    "evidence_cutoff",
    "hypothesis_ids",
    "sources",
    "packet_sha256"
  ],
  "properties": {
    "pilot_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "evidence_cutoff": {"type": "string", "format": "date-time"},
    "hypothesis_ids": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "date",
          "institution",
          "title",
          "url",
          "source_class",
          "independence_group",
          "included_claim",
          "limitations"
        ]
      }
    },
    "packet_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
